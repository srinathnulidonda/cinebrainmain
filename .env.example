ALLOWED_HOSTS=api.example.com,127.0.0.1,localhost
FORWARDED_ALLOW_IPS=10.0.0.0/8
TRUST_PROXY_HEADERS=false
COOKIE_SAMESITE=lax
WEB_CONCURRENCY=4
RUN_WORKERS_IN_PROCESS=false
OTEL_EXPORTER_OTLP_ENDPOINT=