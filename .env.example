# .env.example

ENV=production
DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/cinebrain
REDIS_URL=redis://redis-host:6379/0
SECRET_KEY=generate-with-python-secrets-token_urlsafe-48
TMDB_API_KEY=
METRICS_API_KEY=
